{
  "name": "@speckub/cli",
  "description": "AI-agent workflows, Markdown API specifications, and a standalone spec reader.",
  "version": "0.1.2",
  "type": "module",
  "bin": {
    "speckub": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mermaid-js/tiny": "^11.17.2",
    "@speckub/core": "workspace:^",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipondnakab/speckub.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ipondnakab/speckub",
  "bugs": {
    "url": "https://github.com/ipondnakab/speckub/issues"
  }
}
